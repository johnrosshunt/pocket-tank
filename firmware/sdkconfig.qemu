# Overlay for Espressif QEMU (esp32s3 machine): quad PSRAM, max 4 MB.
# The real board is octal 8 MB (sdkconfig.defaults). Build with:
#   idf.py -B build_qemu -DSDKCONFIG=build_qemu/sdkconfig -DSDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.qemu" build
CONFIG_SPIRAM_MODE_OCT=n
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_40M=y
CONFIG_SPIRAM_SPEED=40

# QEMU may not emulate PSRAM: keep booting without it (plan becomes a warning)
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
# QEMU: no panel, no touch
CONFIG_POCKET_TANK_DISPLAY_CO5300=n
CONFIG_POCKET_TANK_TOUCH_CST9217=n
CONFIG_POCKET_TANK_AUDIO_ES8311=n
